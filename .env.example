# Secret key for Stripe API calls
STRIPE_SECRET_KEY=

# Signing secret used to verify webhook events
STRIPE_WEBHOOK_SECRET=

# Public site origin for Checkout return URLs and the billing portal
DOMAIN=

# Stripe price ID for the yearly plan
PRICE_YEARLY=

# Stripe price ID for the monthly plan
PRICE_MONTHLY=

# Port the server listens on. Defaults to 4242 when unset
PORT=
